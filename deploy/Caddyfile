microfinity.lol {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        -Server
    }
    reverse_proxy 127.0.0.1:3000
}

www.microfinity.lol {
    redir https://microfinity.lol{uri} permanent
}
