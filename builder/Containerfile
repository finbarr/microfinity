FROM public.ecr.aws/docker/library/node:22.22.0-bookworm-slim AS toolkit
RUN apt-get update && apt-get install -y --no-install-recommends chromium ca-certificates fonts-dejavu-core ripgrep && rm -rf /var/lib/apt/lists/*
WORKDIR /kit
COPY package.json package-lock.json ./
RUN npm ci && npm install --global @openai/codex@0.156.1
COPY sdk ./sdk
COPY runtime ./runtime
COPY server/compiler.ts server/compile-process.ts server/compile-child.ts ./server/
COPY client/renderer.ts ./client/
COPY builder ./builder
COPY tsconfig.json ./
RUN mkdir -p /input /references /media /bridge /work /scratch && chmod 1777 /bridge && \
    printf '#!/bin/sh\ncd /kit\nexec flock -w 180 /scratch/game-tool.lock node --import tsx /kit/builder/tools.ts "$@"\n' > /usr/local/bin/game-tool && chmod 755 /usr/local/bin/game-tool
USER 10001:10001
ENV HOME=/scratch/home CODEX_HOME=/scratch/codex TMPDIR=/scratch
ENTRYPOINT ["node", "/kit/builder/entry.mjs"]

FROM toolkit AS blaxel
USER root
RUN apt-get update && apt-get install -y --no-install-recommends bubblewrap && rm -rf /var/lib/apt/lists/* && \
    mkdir -p /control /bl && chmod 700 /control && chown 10001:10001 /work /scratch && chmod 755 /kit/builder/blaxel-run.sh
COPY --from=ghcr.io/blaxel-ai/sandbox:latest /sandbox-api /usr/local/bin/sandbox-api
ENV SANDBOX_DISABLE_PROCESS_LOGGING=true
ENTRYPOINT ["/usr/local/bin/sandbox-api"]
