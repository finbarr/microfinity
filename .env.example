OPENAI_API_KEY=
TYPESAFE_API_KEY=
# Structured brief and soundtrack planning; Codex builds the game separately.
BRIEF_MODEL=gpt-6-sol
MUSIC_MODEL=gpt-5-mini
IMAGE_MODEL=gpt-image-1.5
# Locally, use bl login. Production reads BL_API_KEY from its protected providers file.
BL_WORKSPACE=
BL_API_KEY=
# Pin the immutable image returned by bl get image sandbox/microfinity-builder --latest.
BLAXEL_BUILDER_IMAGE=
BLAXEL_REGION=us-was-1
BUILDER_MODEL=gpt-6-sol
BUILDER_REASONING_EFFORT=medium
# Maximum concurrent active turns across workers sharing PostgreSQL.
BUILDER_CONCURRENCY=2
# Optional slots on this worker process; defaults to the global limit.
BUILDER_WORKER_SLOTS=2
# Use external with PostgreSQL and run npm run builder in a separate process.
# Leave embedded for local single-process PGlite development.
BUILDER_WORKER=embedded
# Whole turn deadline; media has separate cumulative provider reservations.
GENERATION_TIMEOUT_MS=900000
GENERATION_MAX_CALLS=8
GENERATION_MAX_INPUT_BYTES=300000
GENERATION_MAX_OUTPUT_TOKENS=54000
GENERATION_MUSIC_ATTEMPTS=2
JEV_MODEL=jev-1.13.0
JEV_INTERVAL_MS=200
JEV_CONCURRENCY=4
PORT=3000
# Optional external PostgreSQL. Otherwise local PostgreSQL via PGlite in data/db.
DATABASE_URL=

# Optional local assets/database directory (default: data).
DATA_DIR=data
