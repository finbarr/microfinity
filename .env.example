OPENAI_API_KEY=
TYPESAFE_API_KEY=
CODE_MODEL=gpt-5-mini
MUSIC_MODEL=gpt-5-mini
IMAGE_MODEL=gpt-image-1.5
# Shared creation work budget (after the initial durable admission write).
# Requests reserve their full requested output allowance, even on failure.
GENERATION_TIMEOUT_MS=300000
GENERATION_MAX_CALLS=8
GENERATION_MAX_INPUT_BYTES=300000
GENERATION_MAX_OUTPUT_TOKENS=54000
GENERATION_CODE_ATTEMPTS=3
GENERATION_MUSIC_ATTEMPTS=2
GENERATION_CACHED_JOBS=32
JEV_MODEL=jev-1.13.0
JEV_INTERVAL_MS=200
JEV_CONCURRENCY=4
PORT=3000
# Optional external PostgreSQL. Otherwise local PostgreSQL via PGlite in data/db.
DATABASE_URL=

# Optional local assets/database directory (default: data).
DATA_DIR=data
